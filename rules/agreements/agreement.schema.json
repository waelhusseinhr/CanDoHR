{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cando-hris.example/schemas/collective-agreement.schema.json",
  "title": "CanDo collective agreement rule set",
  "description": "Machine-readable terms of one collective agreement. Every rule cites the article it came from and records who verified it. Payroll (03), Time & Leave (06), Benefits (05), Recruitment (02), Offboarding (11) and Core HR (01) read these rules; none keeps its own copy.",
  "type": "object",
  "required": [
    "agreement",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "agreement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "union",
        "jurisdiction",
        "term",
        "status",
        "source_document"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "union": {
          "type": "string"
        },
        "local": {
          "type": "string"
        },
        "bargaining_unit_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "employer_entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jurisdiction": {
          "enum": [
            "FED",
            "NL",
            "PE",
            "NS",
            "NB",
            "QC",
            "ON",
            "MB",
            "SK",
            "AB",
            "BC",
            "YT",
            "NT",
            "NU"
          ]
        },
        "term": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "status": {
          "enum": [
            "in_force",
            "expired_bridging",
            "in_bargaining",
            "superseded"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": [
              "en",
              "fr"
            ]
          }
        },
        "source_document": {
          "type": "object",
          "required": [
            "registry",
            "sha256"
          ],
          "properties": {
            "registry": {
              "enum": [
                "negotech",
                "ontario_e_library",
                "bc_registry",
                "ab_registry",
                "nl_registry",
                "ns_registry",
                "pe_registry",
                "yt_registry",
                "nt_registry",
                "signed_copy"
              ]
            },
            "url": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "retrieved_on": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "article"
      ],
      "properties": {
        "article": {
          "type": "string",
          "description": "Article or schedule reference, e.g. '17.03' or 'Schedule A'"
        },
        "page": {
          "type": "integer"
        },
        "quote": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "extracted_by",
        "verified"
      ],
      "properties": {
        "extracted_by": {
          "enum": [
            "ai",
            "human"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "verified_by": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "description": "Selectors from docs/17 section 11.2. The most specific matching scope wins.",
      "properties": {
        "classifications": { "type": "array", "items": { "type": "string" } },
        "position_groups": { "type": "array", "items": { "type": "string" } },
        "org_nodes": { "type": "array", "items": { "type": "string" } },
        "org_subtrees": { "type": "array", "items": { "type": "string" } },
        "locations": { "type": "array", "items": { "type": "string" } },
        "schedule_types": { "type": "array", "items": { "type": "string" } },
        "employment_types": { "type": "array", "items": { "type": "string" } },
        "statuses": { "type": "array", "items": { "type": "string" } },
        "hour_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        },
        "age_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        }
      }
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "effective_from",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "ratified_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "retro_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "If set, payroll recalculates every pay period from this date when the version is activated."
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wage_grids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wage_grid"
          }
        },
        "general_increases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "effective_from",
              "percent",
              "cite",
              "provenance"
            ],
            "properties": {
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "percent": {
                "type": "number"
              },
              "applies_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cite": {
                "$ref": "#/$defs/citation"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "hours_of_work": {
          "type": "object",
          "properties": {
            "normal_daily_hours": {
              "type": "number"
            },
            "normal_weekly_hours": {
              "type": "number"
            },
            "averaging_weeks": {
              "type": "integer"
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "overtime": {
          "type": "object",
          "properties": {
            "thresholds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "basis",
                  "after_hours",
                  "multiplier"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "daily",
                      "weekly",
                      "consecutive_days",
                      "rest_day",
                      "second_rest_day",
                      "holiday"
                    ]
                  },
                  "after_hours": {
                    "type": "number"
                  },
                  "multiplier": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              }
            },
            "distribution": {
              "enum": [
                "seniority",
                "rotation",
                "equalized_hours",
                "manager_discretion"
              ]
            },
            "time_off_in_lieu": {
              "type": "object",
              "properties": {
                "allowed": {
                  "type": "boolean"
                },
                "bank_rate": {
                  "type": "number"
                },
                "bank_max_hours": {
                  "type": "number"
                },
                "payout": {
                  "enum": [
                    "on_request",
                    "fiscal_year_end",
                    "calendar_year_end",
                    "anniversary",
                    "never"
                  ]
                }
              }
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "premiums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/premium"
          }
        },
        "pay_composition": {
          "$ref": "#/$defs/pay_composition"
        },
        "holidays": {
          "type": "object",
          "properties": {
            "extra_days": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "floaters": {
              "type": "integer"
            },
            "worked_multiplier": {
              "type": "number"
            },
            "plus_lieu_day": {
              "type": "boolean"
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "vacation": {
          "type": "object",
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "service_years",
                  "days"
                ],
                "properties": {
                  "service_years": {
                    "type": "number"
                  },
                  "days": {
                    "type": "number"
                  },
                  "pay_percent": {
                    "type": "number"
                  }
                }
              }
            },
            "service_basis": {
              "enum": [
                "continuous_service_date",
                "seniority_date",
                "hours_paid"
              ]
            },
            "carryover_max_days": {
              "type": "number"
            },
            "pay_method": {
              "enum": [
                "time",
                "percent_of_gross_each_period"
              ]
            },
            "week_hours": { "type": "number" },
            "banking": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "per_year": { "type": "number" },
                "cap": { "type": "number" }
              }
            },
            "termination_percent": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "service_years": { "type": "number" },
                  "percent": { "type": "number" }
                }
              }
            },
            "applies_to": {
              "$ref": "#/$defs/applies_to"
            },
            "precedence": {
              "enum": [
                "prevails"
              ]
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "entitlement",
              "paid_percent"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "entitlement": {
                "type": "string",
                "description": "e.g. '18 days per year accrued at 1.5 days per month'"
              },
              "accrual": {
                "enum": [
                  "front_loaded",
                  "per_period",
                  "per_hour_paid",
                  "per_month_service",
                  "none"
                ]
              },
              "paid_percent": {
                "type": "number"
              },
              "carryover": {
                "type": "string"
              },
              "cite": {
                "$ref": "#/$defs/citation"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "probation": {
          "type": "object",
          "properties": {
            "months": {
              "type": "number"
            },
            "hours_worked": {
              "type": "number"
            },
            "extension_allowed": {
              "type": "boolean"
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "seniority": {
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "enum": [
                  "bargaining_unit",
                  "classification",
                  "employer_wide",
                  "department"
                ]
              }
            },
            "accrual": {
              "enum": [
                "calendar_date",
                "hours_paid",
                "hours_worked",
                "points"
              ]
            },
            "points_per_hours": {
              "type": "object",
              "additionalProperties": false,
              "required": ["points", "hours"],
              "properties": {
                "points": { "type": "number" },
                "hours": { "type": "number" }
              }
            },
            "annual_cap": { "type": "number" },
            "break_in_service_months": { "type": "number" },
            "unpaid_leave_adjustment_days": { "type": "number" },
            "retain_after_transfer_out_months": { "type": "number" },
            "reciprocal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "other_unit": { "type": "string" },
                "transfer_on": { "type": "string" },
                "conditions": { "type": "string" }
              }
            },
            "tie_breakers": {
              "type": "array",
              "items": {
                "enum": [
                  "hire_date",
                  "application_date",
                  "lot",
                  "last_name",
                  "employee_number"
                ]
              }
            },
            "lost_on": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "list_posting": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "string"
                },
                "challenge_days": {
                  "type": "integer"
                }
              }
            },
            "applies_to": {
              "$ref": "#/$defs/applies_to"
            },
            "precedence": {
              "enum": [
                "prevails"
              ]
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "job_posting": {
          "type": "object",
          "properties": {
            "internal_posting_days": {
              "type": "integer"
            },
            "selection": {
              "enum": [
                "seniority_if_qualified",
                "merit_with_seniority_tiebreak",
                "relatively_equal_then_seniority",
                "merit"
              ]
            },
            "trial_period_days": {
              "type": "integer"
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "layoff_recall": {
          "type": "object",
          "properties": {
            "notice_weeks": {
              "type": "number"
            },
            "bumping": {
              "type": "boolean"
            },
            "recall_months": {
              "type": "number"
            },
            "severance_formula": {
              "type": "string"
            },
            "grouping": { "type": "string" },
            "bumping_path": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "grouping": { "type": "string" },
                  "equal_or_lower": { "type": "boolean" }
                }
              }
            },
            "applies_to": {
              "$ref": "#/$defs/applies_to"
            },
            "precedence": {
              "enum": [
                "prevails"
              ]
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "union_dues": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "percent_of_gross",
                "percent_of_base",
                "flat_per_period",
                "per_hour_paid"
              ]
            },
            "rate": {
              "type": "number"
            },
            "max_per_period": {
              "type": [
                "number",
                "null"
              ]
            },
            "initiation_fee": {
              "type": [
                "number",
                "null"
              ]
            },
            "remit_to": {
              "type": "string"
            },
            "continues_after_transfer_out_months": { "type": "number" },
            "applies_to": {
              "$ref": "#/$defs/applies_to"
            },
            "precedence": {
              "enum": [
                "prevails"
              ]
            },
            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "retro": {
          "type": "object",
          "properties": {
            "applies_to_pay_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "eligible_population": {
              "enum": [
                "active_on_ratification",
                "active_on_ratification_and_terminated_after_retro_from",
                "all_employed_in_retro_period",
                "terminated_on_application",
                "retirees"
              ]
            },
            "application_days": { "type": "number" },
            "interest": {
              "type": "boolean"
            },
            "applies_to": {
              "$ref": "#/$defs/applies_to"
            },
            "precedence": {
              "enum": [
                "prevails"
              ]
            },

            "cite": {
              "$ref": "#/$defs/citation"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "acting_pay": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "rate_method", "cite", "provenance"],
            "properties": {
              "trigger": { "enum": ["full_day", "majority_of_duties", "hours_min", "consecutive_days_min"] },
              "rate_method": { "enum": ["step_at_least_percent_above", "rate_of_position_incl_premiums", "fixed_premium", "percent_premium"] },
              "percent": { "type": "number" },
              "paid_from": { "enum": ["trigger_met", "first_day"] },
              "credit": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "counter": { "type": "string" },
                  "amount": { "type": "number" }
                }
              },
              "applies_to": { "$ref": "#/$defs/applies_to" },
              "precedence": { "enum": ["prevails"] },
              "cite": { "$ref": "#/$defs/citation" },
              "provenance": { "$ref": "#/$defs/provenance" }
            }
          }
        },
        "status_conversion": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_types", "to_type", "cite", "provenance"],
            "properties": {
              "from_types": { "type": "array", "items": { "type": "string" } },
              "to_type": { "type": "string" },
              "window": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "months": { "type": "number" },
                  "hours": { "type": "number" }
                }
              },
              "measured_over": { "type": "number", "description": "Rolling weeks." },
              "average_hours_min": { "type": "number" },
              "same_grouping": { "type": "boolean" },
              "counts_leaves": { "type": "array", "items": { "type": "string" } },
              "creates_position": { "type": "boolean" },
              "applies_to": { "$ref": "#/$defs/applies_to" },
              "precedence": { "enum": ["prevails"] },
              "cite": { "$ref": "#/$defs/citation" },
              "provenance": { "$ref": "#/$defs/provenance" }
            }
          }
        },
        "rate_protection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "red_circle": { "enum": ["freeze", "general_increases_for_months", "lump_sum"] },
            "out_of_schedule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "notice_months_before_reduction": { "type": "number" }
              }
            },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "cash_in_lieu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "percent": { "type": "number" },
            "replaces": { "type": "array", "items": { "enum": ["benefits", "holiday_pay"] } },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "probation": { "type": "boolean" },
                "months": { "type": "number" }
              }
            },
            "age_bands": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              }
            },
            "grandfathered": { "type": "boolean" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "lieu_time": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "election_at_time_of_work": { "type": "boolean" },
            "payout": { "type": "string" },
            "carryover_months": { "type": "number" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "averaging_cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "length_days": { "type": "number" },
            "anchor": { "type": "string" },
            "target_hours": { "type": "number" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "work_offering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "tiers": { "type": "array", "items": { "type": "string" } },
            "returning_staff_first_refusal": { "type": "boolean" },
            "distribution": { "type": "string" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "unit_hours_cap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "average_weekly_max": { "type": "number" },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "max": { "type": "number" }
                }
              }
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frequency": { "type": "string" },
                "threshold": { "type": "number" }
              }
            },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "discipline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "sunset_months": { "type": "number" },
            "extended_by_absence_days_over": { "type": "number" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "holiday_pay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "average_daily_wage_weeks": { "type": "number" },
            "lieu_day_during": { "type": "array", "items": { "type": "string" } },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "plans": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "pension_plan": { "type": "string" },
            "benefit_association": { "type": "string" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "service_pay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "provenance"],
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "years": { "type": "number" },
                  "amount_per_month": { "type": "number" }
                }
              }
            },
            "paid": { "type": "string" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "grid_floor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_wage_jurisdiction", "margin", "cite", "provenance"],
          "properties": {
            "minimum_wage_jurisdiction": {
              "enum": ["FED", "NL", "PE", "NS", "NB", "QC", "ON", "MB", "SK", "AB", "BC", "YT", "NT", "NU"]
            },
            "margin": { "type": "number" },
            "applies_to": { "$ref": "#/$defs/applies_to" },
            "precedence": { "enum": ["prevails"] },
            "cite": { "$ref": "#/$defs/citation" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      },
      "dependentRequired": {
        "overtime": [
          "pay_composition"
        ],
        "premiums": [
          "pay_composition"
        ],
        "holidays": [
          "pay_composition"
        ]
      },
      "description": "Rules of one agreement version. Whenever a version defines overtime, premiums or holidays it must also define pay_composition, so that every combination of multipliers and premiums has an explicit, cited answer."
    },
    "wage_grid": {
      "type": "object",
      "required": [
        "classification_code",
        "unit",
        "steps",
        "progression",
        "cite",
        "provenance"
      ],
      "properties": {
        "classification_code": {
          "type": "string"
        },
        "classification_title": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "fr": {
              "type": "string"
            }
          }
        },
        "unit": {
          "enum": [
            "hour",
            "week",
            "biweekly",
            "month",
            "year"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "step",
              "rate"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "rate": {
                "$ref": "#/$defs/money"
              }
            }
          }
        },
        "progression": {
          "type": "object",
          "required": [
            "basis",
            "every"
          ],
          "properties": {
            "basis": {
              "enum": [
                "hours_paid",
                "months_service",
                "anniversary",
                "none"
              ]
            },
            "every": {
              "type": "number"
            },
            "requires_satisfactory_review": {
              "type": "boolean"
            },
            "hour_equivalents": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hours": { "type": "number" },
                "months": { "type": "number" }
              }
            },
            "absence_extension_days": { "type": "number" },
            "performance_hold": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "notice_days_min": { "type": "number" },
                "max": { "type": "number" }
              }
            },
            "new_hire_rates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string" },
                  "rate": { "$ref": "#/$defs/money" }
                }
              }
            },
            "relief_credit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "counter": { "type": "string" },
                "amount": { "type": "number" }
              }
            }
          }
        },
        "cite": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "premium": {
      "type": "object",
      "required": [
        "code",
        "type",
        "amount",
        "cite",
        "provenance"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "type": {
          "enum": [
            "shift_evening",
            "shift_night",
            "weekend",
            "standby",
            "on_call",
            "call_back",
            "responsibility",
            "acting",
            "language",
            "hazard",
            "lead_hand",
            "split_shift",
            "meal_allowance",
            "travel"
          ]
        },
        "condition": {
          "type": "object",
          "description": "When the premium applies, evaluated by the time engine.",
          "properties": {
            "hours_between": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "majority_of_shift": {
              "type": "boolean"
            },
            "days": {
              "type": "array",
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              }
            },
            "minimum_hours_paid": {
              "type": "number"
            }
          }
        },
        "amount": {
          "type": "object",
          "properties": {
            "per_hour": {
              "$ref": "#/$defs/money"
            },
            "per_shift": {
              "$ref": "#/$defs/money"
            },
            "percent_of_rate": {
              "type": "number"
            },
            "minimum_hours_at_rate": {
              "type": "number"
            },
            "multiplier": {
              "type": "number"
            }
          }
        },
        "in_regular_rate": {
          "type": "boolean",
          "description": "The premium is part of the regular rate, so overtime and holiday pay are calculated on base + premium and the premium has no separate line for those hours."
        },
        "overtime_interaction": {
          "enum": [
            "multiplied",
            "flat",
            "excluded"
          ],
          "description": "On hours paid with an overtime, rest-day or second-rest-day multiplier: multiplied = premium × multiplier; flat = premium at its own rate; excluded = premium not paid."
        },
        "holiday_interaction": {
          "enum": [
            "multiplied",
            "flat",
            "excluded"
          ],
          "description": "Same choice for hours where holiday is among the multiplier sources (this one governs those hours)."
        },
        "cite": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "anyOf": [
                  {
                    "required": [
                      "per_hour"
                    ]
                  },
                  {
                    "required": [
                      "percent_of_rate"
                    ]
                  }
                ]
              }
            }
          },
          "then": {
            "required": [
              "in_regular_rate",
              "overtime_interaction",
              "holiday_interaction"
            ]
          }
        },
        {
          "if": {
            "required": [
              "in_regular_rate"
            ],
            "properties": {
              "in_regular_rate": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "overtime_interaction": {
                "const": "multiplied"
              },
              "holiday_interaction": {
                "const": "multiplied"
              }
            }
          }
        }
      ]
    },
    "multiplier_source": {
      "enum": [
        "daily",
        "weekly",
        "consecutive_days",
        "rest_day",
        "second_rest_day",
        "holiday"
      ],
      "description": "A source of a pay multiplier for an hour: an overtime threshold basis, or work on a holiday (multiplier from overtime.thresholds[basis=holiday] or holidays.worked_multiplier, never both with different values)."
    },
    "multiplier_conflict": {
      "type": "object",
      "description": "What to pay when exactly this set of multiplier sources applies to the same hours.",
      "required": [
        "when",
        "resolution",
        "cite",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/multiplier_source"
          }
        },
        "resolution": {
          "enum": [
            "greater_of",
            "sum_premiums",
            "multiply",
            "first_in_order"
          ],
          "description": "greater_of: the highest multiplier. sum_premiums: 1 + the sum of each multiplier's part above 1 (1.5 and 1.5 give 2.0). multiply: the product (1.5 and 1.5 give 2.25). first_in_order: the multiplier of the first source in evaluation_order."
        },
        "multiplier_cap": {
          "type": "number",
          "minimum": 1,
          "description": "Upper limit after resolution. The statutory floor still applies after the cap."
        },
        "cite": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "pay_composition": {
      "type": "object",
      "description": "How overtime, holiday and rest-day multipliers combine with each other and with premiums for the same hours. Evaluated by reference/premium_stacking_reference.py; see docs/08 §5.",
      "required": [
        "premium_stacking",
        "multiplier_conflicts",
        "hours_counting",
        "cite",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "premium_stacking": {
          "enum": [
            "all",
            "highest_only"
          ],
          "description": "When several hourly premiums apply to the same hours: pay all of them, or only the highest."
        },
        "exclusive_groups": {
          "type": "array",
          "description": "Premiums of which only the highest is paid for the same hours, even when premium_stacking is 'all' (for example evening and night shift premiums).",
          "items": {
            "type": "object",
            "required": [
              "codes"
            ],
            "additionalProperties": false,
            "properties": {
              "codes": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "cite": {
                "$ref": "#/$defs/citation"
              }
            }
          }
        },
        "multiplier_conflicts": {
          "type": "object",
          "additionalProperties": false,
          "description": "Every set of two or more multiplier sources that can apply to the same hours needs an exact rule here or the default. The verifier rejects a version that leaves one open (UNRESOLVED_INTERACTION).",
          "properties": {
            "default_resolution": {
              "enum": [
                "greater_of",
                "sum_premiums",
                "multiply",
                "first_in_order"
              ]
            },
            "default_cap": {
              "type": "number",
              "minimum": 1
            },
            "default_cite": {
              "$ref": "#/$defs/citation"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/multiplier_conflict"
              }
            }
          }
        },
        "evaluation_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/multiplier_source"
          },
          "description": "Precedence of sources for first_in_order and for ties. Default: holiday, second_rest_day, rest_day, daily, consecutive_days, weekly."
        },
        "hours_counting": {
          "type": "object",
          "required": [
            "daily_overtime_counts_toward_weekly"
          ],
          "additionalProperties": false,
          "properties": {
            "daily_overtime_counts_toward_weekly": {
              "type": "boolean",
              "description": "false = no pyramiding: an hour already paid as daily overtime does not count toward the weekly threshold, so daily and weekly overtime never apply to the same hour."
            },
            "paid_holidays_count_as_worked": {
              "type": "boolean"
            },
            "paid_leave_counts_as_worked": {
              "type": "boolean"
            },
            "call_back_counts_toward_overtime": {
              "type": "boolean"
            },
            "cite": {
              "$ref": "#/$defs/citation"
            }
          }
        },
        "cite": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
