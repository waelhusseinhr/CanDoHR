{
 "description": "Catalogue of benefits, time-off, work-arrangement, allowance and pay practices that CanDo can benchmark (docs/19 §8). Each practice says how the tenant's own value is read from its configuration, so a benchmark compares like with like without retyping plans. Loaded into ref.reward_practice; tenants enable the ones they use and may add their own.",
 "version": "2026.10",
 "value_types": {
  "boolean": "true or false",
  "money": "amount in the unit shown",
  "multiple_of_salary": "multiple of annual base salary",
  "percent": "0 to 100",
  "days": "working days",
  "weeks": "weeks",
  "months": "months",
  "count": "a number",
  "enum": "one of enum_values",
  "text": "free text, not compared"
 },
 "richer_when": {
  "higher": "a larger value is richer",
  "lower": "a smaller value is richer (waiting periods)",
  "yes": "offering it is richer",
  "none": "no richer or leaner direction; shown for information"
 },
 "comparison": {
  "tolerance": {
   "money": 0.05,
   "percent": 0,
   "multiple_of_salary": 0,
   "days": 0,
   "weeks": 0,
   "months": 0,
   "count": 0
  },
  "boolean_common_at_pct": 50,
  "rule": "Compare the tenant value with the market median (or the most common value for booleans and enums; a yes/no practice is common when at least boolean_common_at_pct per cent of organizations have it). Within tolerance is at market; otherwise richer or leaner by richer_when. Prevalence is always shown beside the comparison."
 },
 "plan_design_keys": "designPath values point into benefits.plan.design (added in migration 0005), a JSON object with these keys per plan kind. The Module 05 plan setup screen writes them; values are in the units shown here.",
