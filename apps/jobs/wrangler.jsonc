{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candohr-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart", "region": "aws:ca-central-1" },
  "triggers": { "crons": ["0 * * * *", "15 12 * * *"] }
  // Hourly: seal the audit log. Daily at 12:15 UTC: send the customer the latest seal.
  // Both read through Hyperdrive created with caching disabled.
  // Do not add the binding until that configuration exists.
}
