{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candohr-identity",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart", "region": "aws:ca-central-1" }
