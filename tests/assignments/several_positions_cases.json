    {"id": "SPLIT-005", "kind": "split", "title": "Same request when the position is set to 'either can approve'", "input": {"request": {"start": "2027-03-03T00:00", "end": "2027-03-05T00:00", "capability": "leave"}, "assignments": [{"id": "YO1", "active": ["2023-09-01", null], "planCode": "NONUNION", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "4": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "5": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "MA", "kind": "line", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [1, 2, 3]}}, {"id": "MB", "kind": "program", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [4, 5]}}], "policy": {"mode": "any"}}]}, "expected": {"components": [{"assignment": "YO1", "planCode": "NONUNION", "hours": "15.00", "parts": [{"approvers": ["MA", "MB"], "rule": "any", "hours": "15.00"}]}], "skipped": [], "totalHours": "15.00"}},
    {"id": "SPLIT-006", "kind": "split", "title": "Friday is covered by neither manager: it goes to the line manager", "input": {"request": {"start": "2027-03-05T00:00", "end": "2027-03-06T00:00", "capability": "leave"}, "assignments": [{"id": "YO1", "active": ["2023-09-01", null], "planCode": "NONUNION", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "4": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "5": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "MA", "kind": "line", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [1, 2, 3]}}, {"id": "MB", "kind": "program", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [4]}}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "YO1", "planCode": "NONUNION", "hours": "7.50", "parts": [{"approvers": ["MA"], "rule": "any", "hours": "7.50"}]}], "skipped": [], "totalHours": "7.50"}},
    {"id": "SPLIT-007", "kind": "split", "title": "Managers by hours of the day with an overlap: 08-12 one manager, 12-14 both, 14-20 the other", "input": {"request": {"start": "2027-03-01T00:00", "end": "2027-03-02T00:00", "capability": "leave"}, "assignments": [{"id": "K1", "active": ["2026-01-01", null], "planCode": "NONUNION", "schedule": {"kind": "shifts", "shifts": [{"start": "2027-03-01T08:00", "end": "2027-03-01T20:00", "breakMinutes": 0}]}, "approvers": [{"id": "MA", "kind": "line", "capabilities": ["leave", "time"], "coverage": {"timeWindows": [["08:00", "14:00"]]}}, {"id": "MB", "kind": "administrative", "capabilities": ["leave", "time"], "coverage": {"timeWindows": [["12:00", "20:00"]]}}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "K1", "planCode": "NONUNION", "hours": "12.00", "parts": [{"approvers": ["MA"], "rule": "any", "hours": "4.00"}, {"approvers": ["MA", "MB"], "rule": "all", "hours": "2.00"}, {"approvers": ["MB"], "rule": "any", "hours": "6.00"}]}], "skipped": [], "totalHours": "12.00"}},
    {"id": "SPLIT-008", "kind": "split", "title": "A casual position with no shifts in the range has nothing to take; only the scheduled position gets a part", "input": {"request": {"start": "2027-03-01T00:00", "end": "2027-03-02T00:00", "capability": "leave"}, "assignments": [{"id": "A1", "active": ["2024-04-01", null], "planCode": "IO-VAC-SICK", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "M1", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}, {"id": "A2C", "active": ["2025-01-01", null], "planCode": "PT-SICK", "schedule": {"kind": "none"}, "approvers": [{"id": "M2", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "A1", "planCode": "IO-VAC-SICK", "hours": "7.50", "parts": [{"approvers": ["M1"], "rule": "any", "hours": "7.50"}]}], "skipped": [{"assignment": "A2C", "reason": "NOT_SCHEDULED"}], "totalHours": "7.50"}},
    {"id": "SPLIT-009", "kind": "split", "title": "Half-day leave in an 8-hour shift with a 30-minute unpaid break: the break is prorated (3.75 hours)", "input": {"request": {"start": "2027-03-01T13:00", "end": "2027-03-01T17:00", "capability": "leave"}, "assignments": [{"id": "A1", "active": ["2024-04-01", null], "planCode": "IO-VAC-SICK", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "M1", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "A1", "planCode": "IO-VAC-SICK", "hours": "3.75", "parts": [{"approvers": ["M1"], "rule": "any", "hours": "3.75"}]}], "skipped": [], "totalHours": "3.75"}},
    {"id": "SPLIT-010", "kind": "split", "title": "Overnight shift belongs to the day it starts: Friday 22:00 to Saturday 06:00 goes to the Friday manager", "input": {"request": {"start": "2027-03-06T00:00", "end": "2027-03-06T06:00", "capability": "leave"}, "assignments": [{"id": "N1", "active": ["2026-01-01", null], "planCode": "NONUNION", "schedule": {"kind": "pattern", "weekly": {"5": [{"from": "22:00", "to": "06:00", "breakMinutes": 0}]}}, "approvers": [{"id": "MA", "kind": "line", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [5]}}, {"id": "MB", "kind": "administrative", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [6]}}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "N1", "planCode": "NONUNION", "hours": "6.00", "parts": [{"approvers": ["MA"], "rule": "any", "hours": "6.00"}]}], "skipped": [], "totalHours": "6.00"}},
    {"id": "SPLIT-011", "kind": "split", "title": "The line manager of one position is the requester herself (in her other position): the part goes up to her own manager", "input": {"request": {"start": "2027-03-06T00:00", "end": "2027-03-07T00:00", "person": "P-DANA", "capability": "leave"}, "assignments": [{"id": "D2", "active": ["2026-05-01", null], "planCode": "PT-SICK", "schedule": {"kind": "pattern", "weekly": {"6": [{"from": "09:00", "to": "13:00", "breakMinutes": 0}]}}, "approvers": [{"id": "D1", "kind": "line", "capabilities": ["leave", "time"], "person": "P-DANA", "escalateTo": "DIR"}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "D2", "planCode": "PT-SICK", "hours": "4.00", "parts": [{"approvers": ["DIR"], "rule": "any", "hours": "4.00"}]}], "skipped": [], "totalHours": "4.00"}},
    {"id": "STATUS-001", "kind": "status", "title": "One manager of a 'both' part has not decided yet: the request is still pending", "input": {"parts": [{"id": "p1", "component": "A1", "approvers": ["M1"], "rule": "any"}, {"id": "p2", "component": "YO1", "approvers": ["MA", "MB"], "rule": "all"}, {"id": "p3", "component": "YO1", "approvers": ["MB"], "rule": "any"}], "decisions": [{"approver": "M1", "decision": "approve"}, {"approver": "MA", "decision": "approve"}]}, "expected": {"parts": {"p1": "approved", "p2": "pending", "p3": "pending"}, "components": {"A1": "approved", "YO1": "pending"}, "request": "pending"}},
