    {"id": "RATING-001", "kind": "rating", "title": "Overall rating weighted by FTE x days held: 0.6 FTE rated 4 and 0.4 FTE rated 3 give 3.6, shown as 4", "input": {"method": "fte_weighted", "sections": [{"assignment": "A1", "fte": "0.6", "days": 365, "rating": 4, "rated": true}, {"assignment": "A2", "fte": "0.4", "days": 365, "rating": 3, "rated": true}], "step": "1", "minDays": 60}, "expected": {"overall": "4", "score": "3.6000", "weightsPct": {"A1": "60.00", "A2": "40.00"}, "used": ["A1", "A2"]}},
    {"id": "RATING-002", "kind": "rating", "title": "A position held for 45 days (below the 60-day minimum) gives comments but no weight", "input": {"method": "fte_weighted", "sections": [{"assignment": "A1", "fte": "0.6", "days": 365, "rating": 4, "rated": true}, {"assignment": "A2", "fte": "0.4", "days": 45, "rating": 2, "rated": true}], "step": "1", "minDays": 60}, "expected": {"overall": "4", "score": "4.0000", "weightsPct": {"A1": "100.00"}, "used": ["A1"]}},
