    {"id": "SPLIT-001", "kind": "split", "title": "Sick leave Wednesday and Thursday across two positions: each part goes to its own manager", "input": {"request": {"start": "2027-03-03T00:00", "end": "2027-03-05T00:00", "capability": "leave"}, "assignments": [{"id": "A1", "active": ["2024-04-01", null], "planCode": "IO-VAC-SICK", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "M1", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}, {"id": "A2", "active": ["2025-01-01", null], "planCode": "PT-SICK", "schedule": {"kind": "shifts", "shifts": [{"start": "2027-03-04T10:00", "end": "2027-03-04T18:00", "breakMinutes": 30}, {"start": "2027-03-06T08:00", "end": "2027-03-06T12:00", "breakMinutes": 0}]}, "approvers": [{"id": "M2", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "A1", "planCode": "IO-VAC-SICK", "hours": "7.50", "parts": [{"approvers": ["M1"], "rule": "any", "hours": "7.50"}]}, {"assignment": "A2", "planCode": "PT-SICK", "hours": "7.50", "parts": [{"approvers": ["M2"], "rule": "any", "hours": "7.50"}]}], "skipped": [], "totalHours": "15.00"}},
    {"id": "SPLIT-002", "kind": "split", "title": "Same day, morning in one position and afternoon in the other: leave 10:00 to 15:00 splits by the hours", "input": {"request": {"start": "2027-03-02T10:00", "end": "2027-03-02T15:00", "capability": "leave"}, "assignments": [{"id": "A1", "active": ["2024-04-01", null], "planCode": "IO-VAC-SICK", "schedule": {"kind": "shifts", "shifts": [{"start": "2027-03-02T08:00", "end": "2027-03-02T12:00", "breakMinutes": 0}]}, "approvers": [{"id": "M1", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}, {"id": "A2", "active": ["2025-01-01", null], "planCode": "PT-SICK", "schedule": {"kind": "shifts", "shifts": [{"start": "2027-03-02T13:00", "end": "2027-03-02T17:00", "breakMinutes": 0}]}, "approvers": [{"id": "M2", "kind": "line", "capabilities": ["leave", "time"]}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "A1", "planCode": "IO-VAC-SICK", "hours": "2.00", "parts": [{"approvers": ["M1"], "rule": "any", "hours": "2.00"}]}, {"assignment": "A2", "planCode": "PT-SICK", "hours": "2.00", "parts": [{"approvers": ["M2"], "rule": "any", "hours": "2.00"}]}], "skipped": [], "totalHours": "4.00"}},
    {"id": "SPLIT-003", "kind": "split", "title": "One position, two managers by days (default): Wednesday to the Monday-Wednesday manager, Thursday to the Thursday-Friday manager", "input": {"request": {"start": "2027-03-03T00:00", "end": "2027-03-05T00:00", "capability": "leave"}, "assignments": [{"id": "YO1", "active": ["2023-09-01", null], "planCode": "NONUNION", "schedule": {"kind": "pattern", "weekly": {"1": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "2": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "3": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "4": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}], "5": [{"from": "09:00", "to": "17:00", "breakMinutes": 30}]}}, "approvers": [{"id": "MA", "kind": "line", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [1, 2, 3]}}, {"id": "MB", "kind": "program", "capabilities": ["leave", "time"], "coverage": {"daysOfWeek": [4, 5]}}], "policy": {"mode": "by_coverage", "overlap": "all", "uncovered": "line"}}]}, "expected": {"components": [{"assignment": "YO1", "planCode": "NONUNION", "hours": "15.00", "parts": [{"approvers": ["MA"], "rule": "any", "hours": "7.50"}, {"approvers": ["MB"], "rule": "any", "hours": "7.50"}]}], "skipped": [], "totalHours": "15.00"}},
