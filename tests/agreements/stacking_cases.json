          "SHIFT_NIGHT"
        ]
      },
      "expected": {
        "multiplier": "1",
        "total": "260.80",
        "lines": [
          [
            "time",
            "246.80"
          ],
          [
            "SHIFT_NIGHT",
            "14.00"
          ]
        ]
      }
    },
