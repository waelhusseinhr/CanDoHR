{
  "$comment": "Separation, final pay and records values that the module specifications state only in prose (requirements/02, requirements/11, stories/11). Each one is a rule value, never a constant in code. Merged into rules/employment-standards/ca-2026.json as new keys of each jurisdiction in Step 7, with the core HR additions; a tested edition is never edited (AGENTS rule 15). Every entry is verify_at_load: a value given here comes from the specifications and is checked against the statute before activation; null means not yet researched, and CanDo stops with RULE_NOT_VERIFIED rather than assuming anything (docs/22 FB-008).",
  "version": "2026-10-25",
  "source_decisions": "Hard-coding review, 25 Oct 2026 (docs/22)",
  "keys": {
    "final_pay_deadline": {
      "meaning": "When final pay is due after employment ends, by who ended it.",
      "fields": {
        "employer_ends / employee_quits": "{rule: later_of | within_days | within_hours, days_after_end, hours_after_end, or: next_regular_pay_day}"
      }
    },
    "statutory_severance": {
      "meaning": "Statutory severance pay, where the jurisdiction has it (separate from notice).",
      "fields": {
        "exists": "true | false | null (not researched)",
        "other fields": "as given per jurisdiction"
      }
    },
    "group_termination": {
      "meaning": "Thresholds that make terminations a group (mass) termination, with the longer notice and ministry notice they trigger.",
      "fields": {
        "thresholds": "[{employees_at_least, within_weeks, notice_weeks, ministry_notice}]"
      }
    },
    "temporary_layoff": {
      "meaning": "How long a temporary layoff may last before it becomes a termination.",
      "fields": {
        "max_weeks": "weeks of layoff",
        "within_weeks": "in this many consecutive weeks"
      }
    },
    "records_retention": {
      "meaning": "How long employment and payroll records are kept.",
      "fields": {
        "years": "number of years",
        "from_event": "what the period runs from"
      }
    }
  },
